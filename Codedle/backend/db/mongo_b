// Codedle MongoDB architecture + seed data
// Run with the launcher script so the connection string comes from your .env file:
// node backend/db/run_mongo_b.mjs

(function () {
  const now = new Date();
  const today = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()));

  function ensureCollection(name, validator) {
    const exists = db.getCollectionNames().includes(name);
    if (!exists) {
      db.createCollection(name, {
        validator,
        validationLevel: "strict",
        validationAction: "error",
      });
      return;
    }

    db.runCommand({
      collMod: name,
      validator,
      validationLevel: "moderate",
      validationAction: "error",
    });
  }

  // =====================
  // Collections (same relationship model as SQL)
  // =====================

  ensureCollection("users", {
    $jsonSchema: {
      bsonType: "object",
      required: ["_id", "username", "email", "password_hash", "created_at", "streak_current", "streak_best", "streak_freeze"],
      properties: {
        _id: { bsonType: "string" },
        username: { bsonType: "string", minLength: 1, maxLength: 50 },
        email: { bsonType: "string", minLength: 3, maxLength: 255 },
        password_hash: { bsonType: "string", minLength: 1, maxLength: 255 },
        created_at: { bsonType: "date" },
        streak_current: { bsonType: "int", minimum: 0 },
        streak_best: { bsonType: "int", minimum: 0 },
        streak_freeze: { bsonType: "int", minimum: 0 },
        last_played_date: { bsonType: ["date", "null"] },
      },
      additionalProperties: true,
    },
  });

  ensureCollection("puzzles", {
    $jsonSchema: {
      bsonType: "object",
      required: ["_id", "scheduled_date", "answer", "word_pattern", "display_pattern", "is_active", "created_at"],
      properties: {
        _id: { bsonType: "string" },
        scheduled_date: { bsonType: "date" },
        answer: { bsonType: "string", minLength: 1, maxLength: 255 },
        word_pattern: {
          bsonType: "array",
          minItems: 1,
          items: { bsonType: "int", minimum: 1 },
        },
        display_pattern: { bsonType: "string", minLength: 1, maxLength: 100 },
        is_active: { bsonType: "bool" },
        created_at: { bsonType: "date" },
      },
      additionalProperties: true,
    },
  });

  ensureCollection("roasts", {
    $jsonSchema: {
      bsonType: "object",
      required: ["_id", "message", "created_at"],
      properties: {
        _id: { bsonType: "string" },
        message: { bsonType: "string", minLength: 1, maxLength: 300 },
        created_at: { bsonType: "date" },
      },
      additionalProperties: true,
    },
  });

  ensureCollection("hints", {
    $jsonSchema: {
      bsonType: "object",
      required: ["_id", "puzzle_id", "order_index", "hint_text"],
      properties: {
        _id: { bsonType: "string" },
        puzzle_id: { bsonType: "string" }, // references puzzles._id
        order_index: { bsonType: "int", minimum: 1, maximum: 5 },
        hint_text: { bsonType: "string", minLength: 1, maxLength: 500 },
      },
      additionalProperties: true,
    },
  });

  ensureCollection("challenges", {
    $jsonSchema: {
      bsonType: "object",
      required: ["_id", "puzzle_id", "order_index", "type", "language", "prompt", "code_snippet"],
      properties: {
        _id: { bsonType: "string" },
        puzzle_id: { bsonType: "string" }, // references puzzles._id
        order_index: { bsonType: "int", minimum: 1, maximum: 5 },
        type: {
          bsonType: "string",
          enum: ["output_prediction", "fill_blank", "bug_fix", "reorder", "combo"],
        },
        language: { bsonType: "string", maxLength: 20 },
        prompt: { bsonType: "string", minLength: 1, maxLength: 500 },
        code_snippet: { bsonType: "string" },
        correct_answer: { bsonType: ["string", "null"], maxLength: 500 },
        test_cases: { bsonType: ["array", "null"] },
        correct_order: {
          bsonType: ["array", "null"],
          items: { bsonType: "int", minimum: 1 },
        },
      },
      additionalProperties: true,
    },
  });

  ensureCollection("sessions", {
    $jsonSchema: {
      bsonType: "object",
      required: [
        "_id",
        "user_id",
        "puzzle_id",
        "date",
        "current_challenge",
        "challenge_attempts",
        "challenges_failed",
        "hints_unlocked",
        "answer_lives",
        "status",
        "started_at",
      ],
      properties: {
        _id: { bsonType: "string" },
        user_id: { bsonType: "string" }, // references users._id
        puzzle_id: { bsonType: "string" }, // references puzzles._id
        date: { bsonType: "date" },
        current_challenge: { bsonType: "int", minimum: 0, maximum: 4 },
        challenge_attempts: {
          bsonType: "array",
          minItems: 5,
          maxItems: 5,
          items: { bsonType: "int", minimum: 0, maximum: 5 },
        },
        challenges_failed: {
          bsonType: "array",
          minItems: 5,
          maxItems: 5,
          items: { bsonType: "bool" },
        },
        hints_unlocked: { bsonType: "int", minimum: 0, maximum: 5 },
        answer_lives: { bsonType: "int", minimum: 0, maximum: 3 },
        status: { bsonType: "string", enum: ["in_progress", "solved", "failed"] },
        started_at: { bsonType: "date" },
        finished_at: { bsonType: ["date", "null"] },
        hints_used_on_guess: { bsonType: ["int", "null"], minimum: 1, maximum: 5 },
        score: { bsonType: ["int", "null"], minimum: 0 },
      },
      additionalProperties: true,
    },
  });

  ensureCollection("results", {
    $jsonSchema: {
      bsonType: "object",
      required: ["_id", "user_id", "puzzle_id", "date", "score", "hints_used", "time_taken_secs", "flawless", "created_at"],
      properties: {
        _id: { bsonType: "string" },
        user_id: { bsonType: "string" }, // references users._id
        puzzle_id: { bsonType: "string" }, // references puzzles._id
        date: { bsonType: "date" },
        score: { bsonType: "int", minimum: 0 },
        hints_used: { bsonType: "int", minimum: 1, maximum: 5 },
        time_taken_secs: { bsonType: "int", minimum: 0 },
        flawless: { bsonType: "bool" },
        share_card_data: { bsonType: ["object", "null"] },
        created_at: { bsonType: "date" },
      },
      additionalProperties: true,
    },
  });

  // =====================
  // Indexes
  // =====================

  db.users.createIndex({ email: 1 }, { name: "idx_users_email", unique: true });
  db.users.createIndex({ username: 1 }, { name: "idx_users_username", unique: true });

  db.puzzles.createIndex({ scheduled_date: 1 }, { name: "idx_puzzles_scheduled_date", unique: true });
  db.puzzles.createIndex({ is_active: 1 }, { name: "idx_puzzles_is_active" });

  db.hints.createIndex({ puzzle_id: 1, order_index: 1 }, { name: "uq_hints_puzzle_order", unique: true });

  db.challenges.createIndex({ puzzle_id: 1, order_index: 1 }, { name: "uq_challenges_puzzle_order", unique: true });

  db.sessions.createIndex({ user_id: 1 }, { name: "idx_sessions_user_id" });
  db.sessions.createIndex({ puzzle_id: 1 }, { name: "idx_sessions_puzzle_id" });
  db.sessions.createIndex({ date: 1 }, { name: "idx_sessions_date" });
  db.sessions.createIndex({ status: 1 }, { name: "idx_sessions_status" });
  db.sessions.createIndex({ user_id: 1, puzzle_id: 1 }, { name: "uq_sessions_user_puzzle", unique: true });

  db.results.createIndex({ user_id: 1 }, { name: "idx_results_user_id" });
  db.results.createIndex({ puzzle_id: 1 }, { name: "idx_results_puzzle_id" });
  db.results.createIndex({ date: 1 }, { name: "idx_results_date" });
  db.results.createIndex({ score: -1 }, { name: "idx_results_score" });
  db.results.createIndex({ user_id: 1, puzzle_id: 1 }, { name: "uq_results_user_puzzle", unique: true });

  // =====================
  // View: daily_leaderboard
  // =====================

  if (db.getCollectionNames().includes("daily_leaderboard")) {
    db.daily_leaderboard.drop();
  }

  db.createView(
    "daily_leaderboard",
    "results",
    [
      {
        $addFields: {
          rank_key: [{ $multiply: [-1, "$score"] }, "$time_taken_secs"],
        },
      },
      {
        $lookup: {
          from: "users",
          localField: "user_id",
          foreignField: "_id",
          as: "user",
        },
      },
      { $unwind: "$user" },
      {
        $setWindowFields: {
          partitionBy: "$puzzle_id",
          sortBy: { rank_key: 1 },
          output: {
            rank: { $rank: {} },
          },
        },
      },
      {
        $sort: { score: -1, time_taken_secs: 1 },
      },
      {
        $project: {
          _id: 0,
          username: "$user.username",
          score: 1,
          hints_used: 1,
          time_taken_secs: 1,
          flawless: 1,
          puzzle_id: 1,
          date: 1,
          rank: 1,
        },
      },
    ]
  );

  // =====================
  // Seed data
  // =====================

  let puzzle = db.puzzles.findOne({ scheduled_date: today });

  if (!puzzle) {
    puzzle = {
      _id: UUID().toString(),
      scheduled_date: today,
      answer: "Abraham Lincoln",
      word_pattern: [7, 7],
      display_pattern: "_______ ________",
      is_active: true,
      created_at: new Date(),
    };
    db.puzzles.insertOne(puzzle);
  } else {
    db.puzzles.updateOne(
      { _id: puzzle._id },
      {
        $set: {
          answer: "Abraham Lincoln",
          word_pattern: [7, 7],
          display_pattern: "_______ ________",
          is_active: true,
        },
      }
    );
  }

  db.hints.deleteMany({ puzzle_id: puzzle._id });
  db.hints.insertMany([
    { _id: UUID().toString(), puzzle_id: puzzle._id, order_index: 1, hint_text: "President of America" },
    { _id: UUID().toString(), puzzle_id: puzzle._id, order_index: 2, hint_text: "Second name starts with L" },
    { _id: UUID().toString(), puzzle_id: puzzle._id, order_index: 3, hint_text: "Illegalized human slavery" },
    { _id: UUID().toString(), puzzle_id: puzzle._id, order_index: 4, hint_text: "Assassinated in a theatre" },
    { _id: UUID().toString(), puzzle_id: puzzle._id, order_index: 5, hint_text: "The 16th" },
  ]);

  db.challenges.deleteMany({ puzzle_id: puzzle._id });
  db.challenges.insertMany([
    {
      _id: UUID().toString(),
      puzzle_id: puzzle._id,
      order_index: 1,
      type: "output_prediction",
      language: "python",
      prompt: "Predict the output for this snippet.",
      code_snippet: "x = [1, 2, 3]\\nprint(x[-1] + x[0])",
      correct_answer: "4",
      test_cases: null,
      correct_order: null,
    },
    {
      _id: UUID().toString(),
      puzzle_id: puzzle._id,
      order_index: 2,
      type: "fill_blank",
      language: "python",
      prompt: "Fill in the missing return expression.",
      code_snippet: "def reverse_string(value):\\n    return ______",
      correct_answer: null,
      test_cases: [{ input: "hello", expected: "olleh" }],
      correct_order: null,
    },
    {
      _id: UUID().toString(),
      puzzle_id: puzzle._id,
      order_index: 3,
      type: "bug_fix",
      language: "python",
      prompt: "Fix the bug in the highlighted logic.",
      code_snippet: "def next_score(value):\\n    return value - 1",
      correct_answer: null,
      test_cases: [{ input: 4, expected: 5 }],
      correct_order: null,
    },
    {
      _id: UUID().toString(),
      puzzle_id: puzzle._id,
      order_index: 4,
      type: "reorder",
      language: "python",
      prompt: "Reorder the lines into a valid function.",
      code_snippet: "1) return message\\n2) def greet(name):\\n3) message = f\"Hello, {name}!\"",
      correct_answer: null,
      test_cases: null,
      correct_order: [2, 3, 1],
    },
    {
      _id: UUID().toString(),
      puzzle_id: puzzle._id,
      order_index: 5,
      type: "combo",
      language: "python",
      prompt: "Fix the broken logic and complete the missing line.",
      code_snippet: "def double_then_add_one(value):\\n    result = value * 2\\n    return ______",
      correct_answer: null,
      test_cases: [{ input: 3, expected: 7 }],
      correct_order: null,
    },
  ]);

  const roastMessages = [
    "A semicolon just sighed in disappointment.",
    "Your loop had energy, just not direction.",
    "That bug fix accidentally adopted two new bugs.",
    "The compiler looked away for a second and this happened.",
    "Close one. The syntax almost believed in you.",
    "Your indentation started a civil war.",
    "That function returned confusion with great confidence.",
    "The stack trace wrote a short poem about this attempt.",
    "You were one keystroke away from glory.",
    "Even the linter paused before commenting.",
  ];

  roastMessages.forEach((message) => {
    db.roasts.updateOne(
      { message },
      {
        $setOnInsert: {
          _id: UUID().toString(),
          message,
          created_at: new Date(),
        },
      },
      { upsert: true }
    );
  });

  // =====================
  // API-layer critical rules for developers
  // =====================
  // 1) Never expose challenges.correct_answer, challenges.test_cases, or challenges.correct_order to frontend APIs.
  // 2) All answer checking happens server-side only.
  // 3) Create a session document when user starts today's puzzle, not at registration.
  // 4) Insert one immutable results document only when session status becomes solved/failed; do not update it later.
  // 5) Run streak logic on users when a result is inserted:
  //    compare last_played_date with today, increment/reset streak_current,
  //    consume streak_freeze if applicable before resetting, and update streak_best.

  print("Codedle MongoDB schema and seed complete.");
})();
